{
  "dataset": "PathMNIST",
  "num_classes": 9,
  "num_clients": 5,
  "partition_strategy": "Dirichlet",
  "dirichlet_alpha": 0.3,
  "training_partition_seed": 42,
  "test_partition_seed": 43,
  "noise_type": "Symmetric label noise",
